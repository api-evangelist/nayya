              }
            ],
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Specifies which page of results to retrieve."
              },
              {
                "name": "perPage",
                "value": "",
                "type": "query",
                "description": "Number of results per page."
              },
              {
                "name": "name",
                "value": "",
                "type": "query",
                "description": "Supports like search by name, external ID."
              },
              {
                "name": "sortBy",
                "value": "",
                "type": "query"
              },
              {
                "name": "sortOrder",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Response includes an array with the page and number of results requested. Results are returned in ascending order by `createdAt` date."
        },
        {
